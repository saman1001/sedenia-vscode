{
  "name": "sedenia",
  "displayName": "Sedenia",
  "description": "A local VS Code sidebar for Claude Code and OpenAI Codex sessions, with waiting states, notifications and window switching on Windows.",
  "version": "0.1.3",
  "publisher": "saman1001",
  "private": true,
  "license": "MIT",
  "keywords": ["claude-code", "openai-codex", "session-monitor", "ai-agents", "vscode-extension", "windows", "local-first"],
  "repository": { "type": "git", "url": "https://github.com/saman1001/sedenia-vscode.git" },
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/src/extension.js",
  "files": ["out/src/**", "media/**", "README.md", "LICENSE", "hooks/sedenia_cakanie.py", "hooks/hooks.example.json", "docs/codex-hook.md"],
  "capabilities": { "untrustedWorkspaces": { "supported": true }, "virtualWorkspaces": false },
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "sedenia", "title": "Sedenia", "icon": "media/sedenia.svg" }] },
    "views": { "sedenia": [{ "id": "sedenia.sessions", "name": "Sedenia" }] },
    "commands": [
      { "command": "sedenia.refresh", "title": "Obnoviť sedenia", "category": "Sedenia", "icon": "$(refresh)" },
      { "command": "sedenia.open", "title": "Otvoriť sedenie", "category": "Sedenia" },
      { "command": "sedenia.showOutput", "title": "Zobraziť diagnostiku", "category": "Sedenia", "icon": "$(output)" }
    ],
    "menus": {
      "view/title": [
        { "command": "sedenia.refresh", "when": "view == sedenia.sessions", "group": "navigation" },
        { "command": "sedenia.showOutput", "when": "view == sedenia.sessions" }
      ],
      "commandPalette": [{ "command": "sedenia.open", "when": "false" }]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run build && node --test out/test/*.test.js",
    "test:vscode": "npm run build && node test/run-vscode.cjs",
    "test:hook": "python -I test/hook_test.py",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.3"
  }
}
